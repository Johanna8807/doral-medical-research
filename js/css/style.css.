CSS
body { font-family: Arial, sans-serif; margin: 20px; line-height: 1.6; }
header, footer { background: #f4f4f4; padding: 10px; text-align: center; }
nav ul { list-style: none; padding: 0; display: flex; gap: 15px; justify-content: center; }
nav a { text-decoration: none; color: #0056b3; font-weight: bold; }

.filter-wrapper { margin: 20px 0; padding: 15px; background: #eef2f5; border-radius: 5px; }
.trials-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 15px; }
.study-card { border: 1px solid #ccc; border-left: 5px solid #0056b3; padding: 15px; background: #fff; }
.btn-select { background: #0056b3; color: white; border: none; padding: 8px 12px; cursor: pointer; border-radius: 4px; }

.form-group { margin-bottom: 15px; display: flex; flex-direction: column; }
